{
  "name": "codebasescan",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Local-first static auditing for Node.js, React, and Next.js codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/codebasescan.git"
  },
  "bugs": {
    "url": "https://github.com/andrewsrigom/codebasescan/issues"
  },
  "homepage": "https://github.com/andrewsrigom/codebasescan#readme",
  "keywords": [
    "audit",
    "code-analysis",
    "nextjs",
    "react",
    "security",
    "static-analysis",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "codebasescan": "bin/codebasescan.mjs"
  },
  "files": [
    "bin",
    "configs",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "worker": "node --experimental-strip-types --env-file-if-exists=.env.local src/worker/main.ts",
    "cli": "node --experimental-strip-types --env-file-if-exists=.env.local src/cli/main.ts",
    "build:cli": "node scripts/clean-cli.mjs && tsc --project tsconfig.cli.json",
    "prepack": "npm run build:cli",
    "demo": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/seed.ts",
    "demo:review": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/seed.ts --review",
    "test": "node --experimental-strip-types --test tests/core/*.test.ts",
    "test:graph": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:package": "npm run build:cli && node scripts/check-package.mjs && node scripts/test-install.mjs npm",
    "test:package:pnpm": "npm run build:cli && node scripts/test-install.mjs pnpm",
    "test:package:yarn": "npm run build:cli && node scripts/test-install.mjs yarn",
    "release:metadata": "node scripts/check-release.mjs prepare",
    "release:dry-run": "node scripts/check-publish-dry-run.mjs",
    "release:check": "npm run release:metadata && npm run format:check && npm run typecheck && npm run lint && npm test && npm run benchmark && npm run test:graph && npm run build && npm run test:package && npm run release:dry-run && npm audit --audit-level=low && npm run cli -- doctor --quiet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:graph",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:core": "tsc --project tsconfig.core.json --noEmit",
    "example": "node --experimental-strip-types scripts/export-example.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "dependency-cruiser": "18.2.0",
    "ignore": "^7.0.9",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/ollama": "^1.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "prettier": "^3.6.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/ollama": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-checkpoint-sqlite": {
      "optional": true
    },
    "@langchain/ollama": {
      "optional": true
    }
  }
}
