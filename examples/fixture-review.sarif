{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Traceward",
          "version": "0.2.0",
          "rules": [
            {
              "id": "TW-004",
              "shortDescription": {
                "text": "Object lookup needs tenant authorization review"
              },
              "fullDescription": {
                "text": "An object lookup begins with an ID filter. Authorization may exist elsewhere; inspect middleware, service policy, RLS and the complete call path."
              },
              "help": {
                "text": "Verify object-level access for the authenticated tenant. Add a regression test using two tenants and reject cross-tenant access."
              }
            },
            {
              "id": "TW-005",
              "shortDescription": {
                "text": "Sensitive configuration uses a public environment name"
              },
              "fullDescription": {
                "text": "A sensitive-looking setting has a browser-public naming convention. No active credential or actual browser bundle exposure has been verified."
              },
              "help": {
                "text": "Keep privileged credentials in server-only configuration. If exposure is verified, rotate the credential and review its use."
              }
            },
            {
              "id": "TW-007",
              "shortDescription": {
                "text": "Destructive agent tool needs permission review"
              },
              "fullDescription": {
                "text": "A potentially destructive operation appears in an agent tool list. The pattern cannot determine whether approval and authorization are enforced inside the tool."
              },
              "help": {
                "text": "Apply authorization inside each tool, restrict its capability, and require explicit approval where the operation warrants it."
              }
            },
            {
              "id": "TW-003",
              "shortDescription": {
                "text": "Dynamic code execution needs trust-boundary review"
              },
              "fullDescription": {
                "text": "A dynamic execution sink was detected. This is a pattern match, not proof of attacker-controlled execution."
              },
              "help": {
                "text": "Replace dynamic code execution with explicit operations where possible; otherwise document and enforce the trust boundary."
              }
            },
            {
              "id": "TW-001",
              "shortDescription": {
                "text": "Raw SQL execution needs input tracing"
              },
              "fullDescription": {
                "text": "An unsafe SQL execution API is present. User control of the query and runtime reachability have not been established."
              },
              "help": {
                "text": "Prefer parameterized queries. Trace every value reaching this call before deciding whether an injection vulnerability exists."
              }
            },
            {
              "id": "TW-002",
              "shortDescription": {
                "text": "HTML rendering bypass needs sanitization review"
              },
              "fullDescription": {
                "text": "Raw HTML reaches a React rendering sink. The scanner does not prove that the value is attacker-controlled or unsanitized."
              },
              "help": {
                "text": "Establish the source of the HTML and verify an appropriate sanitizer. Prefer rendering text when rich HTML is unnecessary."
              }
            },
            {
              "id": "TW-006",
              "shortDescription": {
                "text": "Wildcard cross-origin policy needs context review"
              },
              "fullDescription": {
                "text": "A wildcard CORS origin was found. Public endpoints may intentionally permit it; authentication and exposed data determine the risk."
              },
              "help": {
                "text": "Define expected browser origins and validate the credential model. Do not treat CORS as an authorization mechanism."
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
